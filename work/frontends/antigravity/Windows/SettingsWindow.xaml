<Window
    x:Class="AntigravityFrontend.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AntigravityFrontend.Controls"
    Title="LumiBar 设置 · Antigravity 玻璃 UI">

    <ContentControl x:Name="FontHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
    <Grid x:Name="RootGrid">
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="176"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="8" Padding="10,8,8,4">
                    <Border Width="24" Height="24" CornerRadius="7" Background="#FF60CDFF">
                        <TextBlock Text="✨" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="LumiBar" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="常规" Tag="general">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="外观与光效" Tag="appearance" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="任务栏与胶囊" Tag="taskbar">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE75E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="天气与单位" Tag="weather">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE753;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="音乐与歌词" Tag="music">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="插件交互" Tag="plugin">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEA86;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer Padding="24,18,24,24">
                <StackPanel Spacing="16" MaxWidth="540">

                    <!-- Page: General -->
                    <StackPanel x:Name="PageGeneral" Visibility="Collapsed" Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="常规" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="连接 LumiBar 后端、数据刷新与全屏行为" FontSize="12" Opacity="0.7" />
                        </StackPanel>

                        <Border CornerRadius="12" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="数据源模式" FontWeight="SemiBold" />
                                <ToggleSwitch x:Name="MockSwitch" Header="使用示例数据模式（关闭则连接真实 Named Pipe 后端）" Toggled="OnMockToggled" />
                                <TextBox x:Name="EndpointPathBox" Header="后端接口描述文件 (frontend-endpoint.json)" />
                                <TextBlock x:Name="EnvOverrideNoteText" Visibility="Collapsed" FontSize="11" Foreground="#60CDFF" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="保存接口路径" Style="{ThemeResource AccentButtonStyle}" Click="OnSaveEndpointClick" />
                                    <Button Content="切换正式版 LumiBar" Click="OnPresetOfficialEndpointClick" />
                                    <Button Content="切换 Preview 后端" Click="OnPresetPreviewEndpointClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="12" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Windows 任务栏原生接管 (0.7)" FontWeight="SemiBold" />
                                <ToggleSwitch x:Name="TaskbarTakeoverSwitch" Header="启用外部渲染租约并接管 Windows 任务栏原生胶囊" Toggled="OnTaskbarTakeoverToggled" />
                                <TextBlock x:Name="TakeoverStatusText" Text="状态：初始化中..." FontSize="12" Opacity="0.78" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="重新接管任务栏" Click="OnRetryTakeoverClick" />
                                    <Button Content="释放回 LumiBar 内置" Click="OnReleaseTakeoverClick" />
                                    <Button Content="打开预览工作台" Click="OnShowWorkbenchClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="12" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <ComboBox x:Name="RefreshIntervalCombo" Header="天气后台自动刷新间隔" Width="220" SelectionChanged="OnRefreshComboChanged">
                                    <ComboBoxItem Content="10 分钟" Tag="10" />
                                    <ComboBoxItem Content="20 分钟" Tag="20" />
                                    <ComboBoxItem Content="30 分钟" Tag="30" />
                                    <ComboBoxItem Content="60 分钟" Tag="60" />
                                </ComboBox>
                                <ToggleSwitch x:Name="HideFullscreenSwitch" Header="全屏应用时自动隐藏胶囊" Toggled="OnSettingToggleChanged" Tag="hideInFullscreen" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Page: Appearance (Default Selected, matching concept v2) -->
                    <StackPanel x:Name="PageAppearance" Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="外观与光效" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="让桌面透进来，让音乐染上颜色" FontSize="12" Opacity="0.7" />
                        </StackPanel>

                        <Border CornerRadius="12" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="主题" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <RadioButton x:Name="ThemeSystemRadio" GroupName="AppTheme" Content="跟随系统" Tag="System" Checked="OnThemeRadioChecked" />
                                    <RadioButton x:Name="ThemeLightRadio" GroupName="AppTheme" Content="浅色" Tag="Light" Checked="OnThemeRadioChecked" />
                                    <RadioButton x:Name="ThemeDarkRadio" GroupName="AppTheme" Content="深色" Tag="Dark" Checked="OnThemeRadioChecked" />
                                </StackPanel>

                                <Slider x:Name="GlassOpacitySlider" Header="玻璃密度（透明度）" Minimum="35" Maximum="95"
                                        ValueChanged="OnGlassOpacityChanged" />
                                <ToggleSwitch x:Name="CoverGlowSwitch" Header="封面着色（根据当前播放封面在界面融入柔和色彩）"
                                              Toggled="OnSettingToggleChanged" Tag="coverGlow" />
                                <Slider x:Name="GlowIntensitySlider" Header="动态光效强度" Minimum="8" Maximum="55"
                                        ValueChanged="OnGlowChanged" />
                                <ToggleSwitch x:Name="AnimationsSwitch" Header="平滑过渡动画"
                                              Toggled="OnSettingToggleChanged" Tag="animations" />
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="12" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="字体（系统已安装字体）" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ActiveFontText" Grid.Column="1" FontSize="12" Opacity="0.72"
                                               Text="当前：系统默认" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock x:Name="FontWarningText" Visibility="Collapsed" TextWrapping="Wrap"
                                           FontSize="12" Foreground="#FFCC4D"
                                           Text="当前配置的字体未在系统列表中找到，已回退至系统字体，请重新选择或恢复默认。" />

                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="FontSearchBox" PlaceholderText="搜索系统字体（支持中英文名称/别名）..."
                                             TextChanged="OnFontSearchTextChanged" />
                                    <Button x:Name="RefreshFontsBtn" Grid.Column="1" Content="刷新"
                                            Click="OnRefreshFontsClick" />
                                    <Button x:Name="ResetFontBtn" Grid.Column="2" Content="恢复系统默认"
                                            Click="OnResetFontClick" />
                                </Grid>

                                <ListView x:Name="FontsListView" MaxHeight="180" SelectionMode="Single"
                                          BorderThickness="1" BorderBrush="#24FFFFFF" CornerRadius="8"
                                          SelectionChanged="OnFontListSelectionChanged" />

                                <Border CornerRadius="8" Padding="12,10" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="实时预览" FontSize="11" Opacity="0.65" />
                                        <TextBlock x:Name="FontPreviewText" Text="微光 · 奎文区 12° / Aa 0123456789"
                                                   FontSize="15" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock x:Name="FontActionStatusText" FontSize="12" Opacity="0.72"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button x:Name="ApplyFontBtn" Grid.Column="1" Content="应用所选字体"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Click="OnApplyFontClick" IsEnabled="False" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="12" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="效果预览" FontWeight="SemiBold" />
                                <Border CornerRadius="12" Padding="14,12" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <controls:MusicCapsuleControl x:Name="PreviewMusicCapsule" />
                                        <controls:WeatherCapsuleControl x:Name="PreviewWeatherCapsule" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Page: Taskbar & Capsules -->
                    <StackPanel x:Name="PageTaskbar" Visibility="Collapsed" Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="任务栏与胶囊" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="控制双胶囊的显示、宽度与间距（音乐在左，天气在右）" FontSize="12" Opacity="0.7" />
                        </StackPanel>

                        <Border CornerRadius="12" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <ToggleSwitch x:Name="ShowMusicSwitch" Header="显示音乐胶囊" Toggled="OnSettingToggleChanged" Tag="showMusic" />
                                <ToggleSwitch x:Name="ShowWeatherSwitch" Header="显示天气胶囊" Toggled="OnSettingToggleChanged" Tag="showWeather" />
                                <Slider x:Name="MusicWidthSlider" Header="标准音乐胶囊宽度 (180 – 340 DIP)"
                                        ValueChanged="OnMusicWidthChanged" />
                                <Slider x:Name="GapSlider" Header="双胶囊间距 (4 – 24 DIP)" Maximum="24" Minimum="4"
                                        ValueChanged="OnGapChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Page: Weather -->
                    <StackPanel x:Name="PageWeather" Visibility="Collapsed" Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="天气与单位" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="前端负责摄氏/华氏与 km/h ↔ m/s 换算" FontSize="12" Opacity="0.7" />
                        </StackPanel>

                        <Border CornerRadius="12" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <ToggleSwitch x:Name="FahrenheitSwitch" Header="使用华氏度 (°F)" Toggled="OnSettingToggleChanged" Tag="fahrenheit" />
                                <ToggleSwitch x:Name="WindMpsSwitch" Header="风速使用米/秒 (m/s)" Toggled="OnSettingToggleChanged" Tag="windMetersPerSecond" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Page: Music & Lyrics -->
                    <StackPanel x:Name="PageMusic" Visibility="Collapsed" Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="音乐与歌词" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="实时频谱灵敏度与歌词字号偏移" FontSize="12" Opacity="0.7" />
                        </StackPanel>

                        <Border CornerRadius="12" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <ToggleSwitch x:Name="SpectrumSwitch" Header="启用 20 段背景音频频谱" Toggled="OnSettingToggleChanged" Tag="spectrum" />
                                <Slider x:Name="SensitivitySlider" Header="频谱灵敏度 (0.5x – 2.5x)" Minimum="5" Maximum="25"
                                        ValueChanged="OnSensitivityChanged" />
                                <ToggleSwitch x:Name="AutoLyricsSwitch" Header="切歌时自动匹配歌词" Toggled="OnSettingToggleChanged" Tag="autoLyrics" />
                                <Slider x:Name="LyricsFontSlider" Header="歌词字号 (18 – 36)" Minimum="18" Maximum="36"
                                        ValueChanged="OnLyricsFontChanged" />
                                <Slider x:Name="LyricsOffsetSlider" Header="歌词时间偏移 (-5s ~ +5s)" Minimum="-5" Maximum="5" StepFrequency="0.5"
                                        ValueChanged="OnLyricsOffsetChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Page: Plugin Interaction Settings (Frontend-owned) -->
                    <StackPanel x:Name="PagePlugin" Visibility="Collapsed" Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="插件交互设置" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="由 Antigravity 前端本地持久化，独立于后端设置" FontSize="12" Opacity="0.7" />
                        </StackPanel>

                        <Border CornerRadius="12" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <ComboBox x:Name="PopupDirectionCombo" Header="浮窗默认弹出方向" Width="200" SelectionChanged="OnPopupDirectionChanged">
                                    <ComboBoxItem Content="向上弹出 (Up)" Tag="Up" />
                                    <ComboBoxItem Content="向下弹出 (Down)" Tag="Down" />
                                </ComboBox>
                                <ToggleSwitch x:Name="CloseOnDeactivateSwitch" Header="点击浮窗外部自动收起（未固定时）" Toggled="OnCloseOnDeactivateToggled" />
                                <Slider x:Name="LyricsWidthSlider" Header="歌词浮窗宽度 (DIP)" ValueChanged="OnFlyoutSizeChanged" />
                                <Slider x:Name="LyricsHeightSlider" Header="歌词浮窗高度 (DIP)" ValueChanged="OnFlyoutSizeChanged" />
                                <Slider x:Name="WeatherWidthSlider" Header="天气浮窗宽度 (DIP)" ValueChanged="OnFlyoutSizeChanged" />
                                <Slider x:Name="WeatherHeightSlider" Header="天气浮窗最大自适应高度上限 (DIP)" ValueChanged="OnFlyoutSizeChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
    </ContentControl>
</Window>
