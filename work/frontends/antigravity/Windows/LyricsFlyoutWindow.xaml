<Window
    x:Class="AntigravityFrontend.Windows.LyricsFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AntigravityFrontend.Controls"
    Title="LumiBar 歌词与播放控制">

    <ContentControl x:Name="FontHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
        <Border x:Name="RootFrame" CornerRadius="12" BorderThickness="1" Background="#090814">
            <Border.ContextFlyout>
                <MenuFlyout x:Name="FlyoutMenu">
                    <MenuFlyoutItem x:Name="PinMenuItem" Text="固定浮窗（失焦不自动收起）" Click="OnPinClick" />
                    <MenuFlyoutItem Text="重新匹配歌词" Click="OnRefreshLyricsClick" />
                    <MenuFlyoutItem Text="导入本地 LRC 歌词" Click="OnOpenImportClick" />
                    <ToggleMenuFlyoutItem x:Name="CoverGlowMenuItem" Text="专辑氛围背景" Click="OnCoverGlowToggleClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="打开设置" Click="OnSettingsClick" />
                    <MenuFlyoutItem Text="关闭浮窗" Click="OnCloseClick" />
                </MenuFlyout>
            </Border.ContextFlyout>

            <Grid>
                <!-- Outrun Twilight Sky + Album-Sampled Horizon Sunset + Shimmering Ground Grid -->
                <Grid x:Name="SynthwaveBackdropHost" IsHitTestVisible="False" SizeChanged="OnSynthwaveBackdropSizeChanged">
                    <Canvas x:Name="SynthwaveStageCanvas" />
                </Grid>

                <!-- 1:1 4-Zone Vertical Layout -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="106" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Zone 1: Header (32px) -->
                    <Grid Grid.Row="0" Padding="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border x:Name="SourceBadge" CornerRadius="6" Padding="10,2" BorderThickness="1">
                                <TextBlock x:Name="SourceText" Text="cloudmusic.exe" FontSize="10.5"
                                           FontWeight="SemiBold" CharacterSpacing="40" />
                            </Border>
                            <TextBlock x:Name="LyricsStatusText" Text="DMC-12 // LUCIDA MONO" FontSize="10"
                                       CharacterSpacing="35" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock x:Name="ElapsedHeaderBadge" Grid.Column="1" Text="CH-A · 00:00"
                                   FontSize="10" CharacterSpacing="70" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Zone 2: Locked C2 Lyrics Stage -->
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="LyricsScrollViewer"
                                      Padding="14,4"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="LyricsContainer" Spacing="5" VerticalAlignment="Center" />
                        </ScrollViewer>

                        <StackPanel x:Name="LyricsEmptyPanel"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="6"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="LyricsEmptyTitle" Text="暂无同步歌词" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="LyricsEmptyDesc" Text="右键菜单可重新匹配歌词或导入本地 LRC 文本" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Zone 3: 14x8 Full-Height VFD Spectrum Window (Directly above Console) -->
                    <Grid Grid.Row="2">
                        <TextBlock Text="0dB PEAK // TACTILE DECK"
                                   FontSize="9"
                                   CharacterSpacing="85"
                                   Foreground="#73FDA4AF"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="0,4,18,0"
                                   IsHitTestVisible="False" />

                        <controls:SpectrumBackdropControl x:Name="SpectrumBackdrop"
                                                          Height="90"
                                                          VerticalAlignment="Bottom"
                                                          Margin="15,0,15,2" />
                    </Grid>

                    <!-- Zone 4: Single Smoked-Acrylic Console with 4-Pass Reflection & 3 B1 Keys + 32-Seg VFD Progress -->
                    <Border x:Name="ControlDeckCard"
                            Grid.Row="3"
                            Margin="12,0,12,10"
                            CornerRadius="8"
                            Padding="10,10"
                            BorderThickness="1">
                        <Grid>
                            <!-- 56px Top Optical Reflection Canvas (Soft aura + 3-row mirrored bricks + Fresnel + 1.2px rim) -->
                            <Canvas x:Name="DeckReflectionCanvas"
                                    Height="56"
                                    VerticalAlignment="Top"
                                    Margin="-10,-10,-10,0"
                                    IsHitTestVisible="False" />

                            <StackPanel Spacing="8">
                                <!-- Console Row A: Art + Track Info + Exact 3-Key B1 Hardware Tray -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="DockCoverBorder" Width="32" Height="32" CornerRadius="6" BorderThickness="1">
                                        <Grid>
                                            <TextBlock x:Name="DockCoverFallback" Text="🌇" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image x:Name="DockCoverImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock x:Name="TrackTitleText" Text="Midnight Echo" FontSize="11.5" FontWeight="Bold"
                                                   CharacterSpacing="24" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock x:Name="TrackArtistText" Text="Lumi Synth" FontSize="9.5"
                                                   CharacterSpacing="16" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </StackPanel>

                                    <Border x:Name="HardwareTray" Grid.Column="2" CornerRadius="6" Padding="4" BorderThickness="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button x:Name="PrevBtn" Width="24" Height="24" Padding="0" CornerRadius="4" BorderThickness="1"
                                                    Click="OnPrevClick" ToolTipService.ToolTip="上一首">
                                                <FontIcon Glyph="&#xE892;" FontSize="10" />
                                            </Button>
                                            <Button x:Name="PlayPauseBtn" Width="30" Height="24" Padding="0" CornerRadius="4" BorderThickness="1"
                                                    Click="OnToggleClick" ToolTipService.ToolTip="播放 / 暂停">
                                                <Grid Width="28" Height="22">
                                                    <Border Width="6" Height="1.5" CornerRadius="1" Background="#FF7A00"
                                                            VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,2,0,0"
                                                            IsHitTestVisible="False" />
                                                    <FontIcon x:Name="PlayPauseGlyph" Glyph="&#xE769;" FontSize="11"
                                                              VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </Grid>
                                            </Button>
                                            <Button x:Name="NextBtn" Width="24" Height="24" Padding="0" CornerRadius="4" BorderThickness="1"
                                                    Click="OnNextClick" ToolTipService.ToolTip="下一首">
                                                <FontIcon Glyph="&#xE893;" FontSize="10" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Console Row B: 32-Segment Recessed VFD Progress Track + Timestamps -->
                                <StackPanel Spacing="4">
                                    <Border x:Name="VfdProgressTray"
                                            Height="12"
                                            CornerRadius="4"
                                            Padding="4,0"
                                            BorderThickness="1"
                                            PointerPressed="OnVfdProgressPointerPressed"
                                            PointerMoved="OnVfdProgressPointerMoved"
                                            PointerReleased="OnVfdProgressPointerReleased"
                                            PointerCaptureLost="OnVfdProgressPointerCaptureLost"
                                            ToolTipService.ToolTip="点击或拖动跳转进度">
                                        <Grid x:Name="VfdProgressGrid" ColumnSpacing="2" Height="6" VerticalAlignment="Center" />
                                    </Border>

                                    <Grid>
                                        <TextBlock x:Name="ElapsedText" Text="00:00" FontSize="10" CharacterSpacing="55" Foreground="#00F5D4" />
                                        <TextBlock x:Name="FooterHintText" Text="RETRO MONO // G3+B1" FontSize="9.5"
                                                   CharacterSpacing="35" Opacity="0.68" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="DurationText" Text="00:00" FontSize="10" CharacterSpacing="55"
                                                   Opacity="0.72" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Inline LRC Import Drawer (opened from ContextMenu) -->
                    <Border x:Name="ImportDrawer"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Margin="14,6"
                            Visibility="Collapsed"
                            CornerRadius="10"
                            Padding="12"
                            BorderThickness="1"
                            VerticalAlignment="Stretch">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="粘贴 LRC 歌词文本（最多 12,000 字符）" FontSize="12" FontWeight="SemiBold" />
                            <TextBox x:Name="LrcInputBox"
                                     Grid.Row="1"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     PlaceholderText="[00:12.00] 在此粘贴歌词..."
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Content="取消" Click="OnCancelImportClick" />
                                <Button Content="导入并应用" Style="{ThemeResource AccentButtonStyle}" Click="OnConfirmImportClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </ContentControl>
</Window>
