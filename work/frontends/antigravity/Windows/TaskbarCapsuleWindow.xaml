<Window
    x:Class="AntigravityFrontend.Windows.TaskbarCapsuleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AntigravityFrontend.Controls"
    Title="LumiBar Taskbar Capsule">

    <Grid x:Name="RootGrid" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <controls:MusicCapsuleControl x:Name="MusicControl"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Visibility="Collapsed" />
        <controls:WeatherCapsuleControl x:Name="WeatherControl"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Visibility="Collapsed" />
    </Grid>
</Window>
