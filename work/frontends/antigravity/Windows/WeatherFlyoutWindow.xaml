<Window
    x:Class="AntigravityFrontend.Windows.WeatherFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AntigravityFrontend.Controls"
    Title="LumiBar 天气详情">

    <ContentControl x:Name="FontHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
        <Border x:Name="RootFrame" CornerRadius="8" BorderThickness="0">
            <Grid>
                <Grid x:Name="WeatherBackdropHost" IsHitTestVisible="False" SizeChanged="OnBackdropHostSizeChanged">
                    <Border x:Name="WeatherAmbientLayer" CornerRadius="8" />
                    <Border x:Name="WeatherLightningOverlay" CornerRadius="8" Opacity="0" />
                    <Canvas x:Name="WeatherAuraCanvas" />
                </Grid>

                <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" Padding="20,16,20,18">
                    <StackPanel x:Name="ContentStack" Spacing="10">

                    <!-- Header: City + Updated + Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="CityNameText" Text="奎文区" FontSize="17" FontWeight="Bold" />
                                <TextBlock x:Name="RegionText" Text="山东省 · 潍坊市" FontSize="12" Opacity="0.68" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                            </StackPanel>
                            <TextBlock x:Name="UpdatedText" Text="更新于 --" FontSize="12" Opacity="0.65" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                            <Button x:Name="RefreshBtn" Width="30" Height="30" Padding="0" CornerRadius="8"
                                    Background="Transparent" BorderThickness="0"
                                    Click="OnRefreshClick" ToolTipService.ToolTip="刷新天气">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            </Button>
                            <Button x:Name="CityPanelToggleBtn" Width="30" Height="30" Padding="0" CornerRadius="8"
                                    Background="Transparent" BorderThickness="0"
                                    Click="OnToggleCityPanelClick" ToolTipService.ToolTip="切换 / 搜索城市">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                            </Button>
                            <Button x:Name="PinBtn" Width="30" Height="30" Padding="0" CornerRadius="8"
                                    Background="Transparent" BorderThickness="0"
                                    Click="OnPinClick" ToolTipService.ToolTip="固定浮窗">
                                <FontIcon x:Name="PinGlyph" Glyph="&#xE718;" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Status / Error Banner (Shown when offline or error) -->
                    <InfoBar x:Name="StatusBanner" IsOpen="False" IsClosable="False" Severity="Warning" />

                    <!-- Collapsible City Search + Favorites + GPS Locate -->
                    <Border x:Name="CitySearchPanel" Visibility="Collapsed" CornerRadius="12" Padding="10" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CityQueryBox" PlaceholderText="输入城市名（如：青岛、静安）" KeyDown="OnCityQueryKeyDown" />
                                <Button Grid.Column="1" Content="搜索" Click="OnSearchCityClick" />
                                <Button Grid.Column="2" Click="OnLocateGpsClick" ToolTipService.ToolTip="使用 Windows GPS 定位（不回退 IP）">
                                    <FontIcon Glyph="&#xE81D;" FontSize="13" />
                                </Button>
                            </Grid>

                            <ProgressBar x:Name="CityLoadingBar" IsIndeterminate="True" Visibility="Collapsed" />
                            <TextBlock x:Name="GpsHintText" FontSize="12" Opacity="0.78" Visibility="Collapsed" TextWrapping="Wrap" />

                            <StackPanel x:Name="CityResultsList" Spacing="4" />
                        </StackPanel>
                    </Border>

                    <!-- Hero Current Weather -->
                    <Grid ColumnSpacing="14" Padding="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="HeroWeatherHost" Width="52" Height="52" VerticalAlignment="Center" Background="Transparent" Tapped="OnHeroWeatherTapped">
                            <Border x:Name="HeroGlowHalo" Width="56" Height="56" Margin="-2" CornerRadius="28" IsHitTestVisible="False" />
                            <TextBlock x:Name="HeroEmoji" Text="☀️" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid x:Name="HeroMistIconHost" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="HeroTempText" Text="12°" FontSize="36" FontWeight="SemiBold" />
                                <TextBlock x:Name="HeroCondText" Text="晴" FontSize="15" FontWeight="Medium" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            </StackPanel>
                            <TextBlock x:Name="HeroRangeFeelsText" Text="最高 14° · 最低 6° · 体感 11°" FontSize="12" Opacity="0.78" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- Current Conditions Metrics: Wind + Humidity + US AQI Air Quality (above future forecasts) -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="WindCard" Grid.Column="0" CornerRadius="12" Padding="12,10" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEC49;" FontSize="12" Opacity="0.72" />
                                    <TextBlock Text="风速与湿度" FontSize="12" Opacity="0.72" />
                                </StackPanel>
                                <TextBlock x:Name="WindText" Text="东南风 12 km/h" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="HumidityText" Text="相对湿度 52%" FontSize="12" Opacity="0.76" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="AqiCard" Grid.Column="1" CornerRadius="12" Padding="12,10" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE9CA;" FontSize="12" Opacity="0.72" />
                                    <TextBlock Text="空气质量 · US AQI" FontSize="12" Opacity="0.72" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="AqiNumberText" Text="83" FontSize="16" FontWeight="Bold" />
                                    <Border x:Name="AqiBadge" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="AqiLevelText" Text="良" FontSize="12" Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="PmText" Text="PM2.5: 25 · PM10: 41 µg/m³" FontSize="12" Opacity="0.74" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 1-Hour Precipitation Trend Component -->
                    <controls:PrecipitationTrendControl x:Name="PrecipTrendCard" />

                    <!-- 24-Hour Trend Chart -->
                    <Border x:Name="HourlyCard" CornerRadius="12" Padding="11,9" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="未来 24 小时趋势" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="HourlySourceNote" FontSize="12" Opacity="0.65" HorizontalAlignment="Right" />
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,12">
                                <Grid MinWidth="360">
                                    <Canvas x:Name="HourlyCurveCanvas" Height="38" Margin="18,4,18,0" VerticalAlignment="Top" />
                                    <StackPanel x:Name="HourlyItemsPanel" Orientation="Horizontal" Spacing="14" Margin="0,42,0,0" />
                                </Grid>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Multi-Day (5 rows visible by default; scroll inside module for full 10 days) -->
                    <Border x:Name="DailyCard" CornerRadius="12" Padding="11,9" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock x:Name="DailyHeaderText" Text="未来天气预报" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="DailyScrollHintText" FontSize="11" Opacity="0.58" HorizontalAlignment="Right" />
                            </Grid>
                            <ScrollViewer x:Name="DailyScrollViewer"
                                          MaxHeight="132"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="DailyRowsPanel" Spacing="5" Padding="0,0,6,0" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Border>
    </ContentControl>
</Window>
