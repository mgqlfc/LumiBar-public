<UserControl
    x:Class="AntigravityFrontend.Controls.PrecipitationTrendControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="RootBorder" CornerRadius="12" Padding="12,10" BorderThickness="1">
        <StackPanel Spacing="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="未来 1 小时降水" FontSize="12" FontWeight="SemiBold" />
                    <Border x:Name="DemoTag" CornerRadius="5" Padding="6,2" Visibility="Collapsed"
                            Background="#2638BDF8">
                        <TextBlock Text="示例" FontSize="12" Foreground="#38BDF8" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="HeadlineText" Grid.Column="1" FontSize="12" Opacity="0.75" />
            </Grid>

            <Grid x:Name="BarsHost" Height="44" Visibility="Collapsed" />

            <TextBlock x:Name="EmptyStateText"
                       Text="短时降水暂不可用（后端正式 1h 分钟级字段接入中）"
                       FontSize="12"
                       Opacity="0.65"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
