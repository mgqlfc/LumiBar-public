    "lyrics": [
      {
        "seconds": 0,
        "text": "在街灯之间，慢慢走远"
      },
      {
        "seconds": 8,
        "text": "The city leaves a light for us"
      },
      {
        "seconds": 16,
        "text": "晚风穿过透明的窗"
      },
      {
        "seconds": 24,
        "text": "We keep a little room for dawn"
      },
      {
        "seconds": 32,
        "text": "让这一刻，停在微光里"
      },
      {
        "seconds": 40,
        "text": "A quieter song beneath the sky"
      },
      {
        "seconds": 48,
        "text": "沿着熟悉的街道回去"
      },
      {
        "seconds": 56,
        "text": "And every window starts to glow"
      },
      {
        "seconds": 64,
        "text": "留一点光，等下个晴天"
      },
      {
        "seconds": 72,
        "text": "The morning finds its way to you"
      },
      {
        "seconds": 80,
        "text": "把喜欢的歌留在此刻"
      },
      {
        "seconds": 88,
        "text": "We carry all the colors home"
      }
